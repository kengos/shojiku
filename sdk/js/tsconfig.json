{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "node18",
    "moduleResolution": "node16",
    "types": ["node"],
    "strict": true,
    // Deliberate, not inherited: the package's few index accesses are
    // provably non-empty (`split` always yields one element; the regex
    // reads go through `?.`), and turning it on would push every test
    // toward non-null assertions, which Biome forbids outright. Revisit
    // if an index access ever reads a length the caller controls.
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
